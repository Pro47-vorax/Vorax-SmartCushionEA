*.set
*.srset

# Cushion / runtime data files generated by SmartCushionEA
SmartCushionEA_cushion.txt
*_cushion.txt

# MQL5 default folders that may get copied accidentally
MQL5/Files/
MQL5/Logs/
MQL5/Profiles/
MQL5/Bases/

